{
  "id": "example.importer.obsidian",
  "name": "obsidian-md",
  "version": "0.1.0",
  "apiVersion": 1,
  "runtime": "js",
  "entry": "main.js",
  "capabilities": [],
  "implements": {
    "describe": 1,
    "importFile": 1
  },
  "contributes": {
    "importers": [
      {
        "format": "example.obsidian",
        "extensions": ["md"],
        "label": "%importer.label%"
      }
    ],
    "locales": {
      "en": { "importer.label": "Obsidian Markdown" },
      "zh-Hans": { "importer.label": "Obsidian Markdown" }
    }
  }
}
